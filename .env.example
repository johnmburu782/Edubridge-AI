# Copy this file to .env for local development. Replace the secret before use.
APP_ENV=development
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://edubridge:edubridge@localhost:5432/edubridge
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_ACCESS_TOKEN_MINUTES=30
FRONTEND_ORIGINS=["http://localhost:5173"]
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
MAX_UPLOAD_SIZE_MB=15
